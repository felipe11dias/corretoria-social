# Copie para .env e ajuste conforme o ambiente:  cp .env.example .env
# O .env NÃO é versionado (ver .gitignore). Este arquivo é só o modelo.

# --- Banco de dados ---
DB_NAME=corretoria-app
DB_USER=postgres
DB_PASSWORD=postgres
# Fora do compose (app rodando na máquina) use localhost.
# Dentro do compose o host é o nome do serviço: db.
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
# Segredo de assinatura HMAC-SHA256: mínimo 256 bits (32 caracteres).
# O valor abaixo é apenas exemplo — gere um próprio e nunca versione o real.
JWT_SECRET=troque-este-segredo-de-exemplo-por-um-de-no-minimo-256-bits
# Expiração do token em milissegundos (3600000 = 1 hora).
JWT_EXPIRATION=3600000

# --- Storage de fotos de anúncio (S3-compatible) ---
# Endereço usado pela aplicação. Fora do compose: http://localhost:9000.
# Dentro do compose o host é o nome do serviço: http://storage:9000.
STORAGE_ENDPOINT=http://localhost:9000
# Endereço usado pelo navegador para baixar a foto — é o que sai nos links da API.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=corretoria-listing-photos
# Credenciais do MinIO local. Em produção use as da conta de serviço do S3 e nunca versione.
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# Portas publicadas pelo MinIO: API e console web.
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
