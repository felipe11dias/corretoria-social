          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{otherUserId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{otherUserId}}"] },
