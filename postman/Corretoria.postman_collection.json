            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{otherUserId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{otherUserId}}"] },
            "description": "A barreira contra IDOR: um token válido não basta para ler o cadastro de outra pessoa trocando o id da URL."
          }
        },
        {
          "name": "Consulta por id via admin (200)",
